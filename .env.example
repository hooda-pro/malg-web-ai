# Copy to .env and fill in (NEVER commit .env to git).
DATABASE_URL=
JWT_SECRET=
TOKENHARBOR_API_KEY=
# Optional extra keys (comma/newline separated, or TOKENHARBOR_API_KEYS1/2/...):
TOKENHARBOR_API_KEYS=
ADMIN_EMAIL=
ADMIN_PASSWORD=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# رفع مرفقات الشات (Cloudinary — تسجيل مجاني بدون كارت، 25 credits شهريًا).
# الرفع المباشر من المتصفح (unsigned): cloud name + اسم الـ unsigned preset.
# (طريقة السيرفر البديلة عبر /api/uploads تحتاج الثلاثة أسفلها — للاستضافات
# التي لا تحجب الرفع مثل Vercel.)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
# من cloudinary.com > Dashboard بعد التسجيل (سيرفر فقط — لا تنشرهم):
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Keep literal \n newlines inside quotes:
FIREBASE_PRIVATE_KEY=
E2B_API_KEY=
E2B_TEMPLATE=
E2B_SANDBOX_MEMORY_MB=
TAVILY_API_KEY=

# ---- Long single-request window (VPS only — Vercel caps every request) ----
# Uncomment for ~1h non-stop generations on a VPS (then rebuild):
# CHAT_NO_NEW_ROUND_MS=3000000
# CHAT_HARD_STOP_MS=3480000
# E2B_COMMAND_TIMEOUT_MS=1800000
# E2B_SESSION_BUDGET_MS=3000000
# E2B_LIFETIME_MS=3600000
# UPSTREAM_IDLE_TIMEOUT_MS=300000

# ---- رابط الموقع العلني (مهم على Render: بدونه الروابط في metadata
# وصور المشاركة تطلع localhost). مثال: https://malg-ai.onrender.com
# NEXT_PUBLIC_SITE_URL=https://malg-ai.onrender.com

# ---- Caddy auto-HTTPS (only needed with --profile https) ----
# SITE_HOST=your-domain.com

# ---- المدفوعات (لاحقاً — بطاقات عبر Stripe) ----
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_BILLING_ENABLED=

# ---- التحليلات (اختيارية) ----
# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_UMAMI_SRC=
# NEXT_PUBLIC_UMAMI_ID=

# ملاحظة: كل الأسرار تبقى على السيرفر (server-side) في إعدادات الاستضافة
# ولا تُوسم بـ NEXT_PUBLIC أبداً — فقط المتغيرات التي تبدأ بـ NEXT_PUBLIC_
# (المفاتيح العامة للتحليلات والفوترة) تظهر للمتصفح، وتُضبط على السيرفر أيضاً.
